# Base de Datos PostgreSQL
POSTGRES_USER=buscaviajes
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=buscaviajes_db
DATABASE_URL=postgresql+psycopg://buscaviajes:supersecretpassword@db:5432/buscaviajes_db

# Proveedor activo: "amadeus" | "serpapi" | "hybrid"
SEARCH_PROVIDER=hybrid

# Amadeus Self-Service API (https://developers.amadeus.com)
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_BASE_URL=https://test.api.amadeus.com

# SerpApi - Google Flights & Google Hotels (https://serpapi.com)
SERPAPI_API_KEY=your_serpapi_key

# Parámetros del Motor de Filtrado
MAX_LAYOVER_MINUTES=360
MIN_SAVINGS_PERCENTAGE=10.0
DEFAULT_CURRENCY=USD

